# Tablet / SSH tunnel (remote E2E)
TABLET_USER=your_user
TABLET_HOST=your_tablet_host
TABLET_CDP_PORT=9222
LOCAL_TUNNEL_PORT=9223
TABLET_SSH_CONNECT_TIMEOUT=8
TABLET_SSH_STRICT_HOST_KEY_CHECKING=accept-new

# Remote app endpoint (homelab/app server)
PLAYWRIGHT_APP_URL=http://your_app_host:5174

# Credenciais para e2e/tablet/login.spec.ts (somente tablet remoto; não commitar valores reais)
E2E_REMOTE_EMAIL=
E2E_REMOTE_PASSWORD=

# Credenciais para fluxo E2E desktop (e2e/general/auth-and-core-flow.spec.ts)
E2E_EMAIL=
E2E_PASSWORD=

# Supabase service_role key para injeção de estado E2E (bypassa RLS)
E2E_SUPABASE_SERVICE_ROLE_KEY=
# Opcional: override da URL do Supabase para E2E (fallback: VITE_SUPABASE_URL)
E2E_SUPABASE_URL=
